<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

<style>
  :root {
    --bg: #0d0d0d;
    --card-bg: #161616;
    --card-border: #2a2a2a;
    --accent: #c9a84c;
    --accent-glow: rgba(201,168,76,0.1);
    --text-primary: #f0ece4;
    --text-muted: #7a7570;
    --row-hover: #1e1e1e;
    --radius: 16px;
  }

  .admin-section {
    background: var(--bg);
    min-height: 100vh;
    padding: 50px 0;
    font-family: 'DM Sans', sans-serif;
  }

  .admin-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .admin-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .admin-title span { color: var(--accent); }

  .btn-add {
    background: var(--accent);
    color: #141212;
    border: none;
    border-radius: 100px;
    padding: 10px 24px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
    white-space: nowrap;
  }

  .btn-add:hover {
    opacity: 0.85;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(210, 191, 139, 0.3);
    color: #191717;
  }

  /* Table wrapper */
  .table-wrap {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    overflow: hidden;
    animation: fadeUp 0.5s ease both;
    background: #eae2e2;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .product-table {
    width: 100%;
    border-collapse: collapse;
    background: #1b1919;
  }

  /* Header */
  .product-table thead tr {
    border-bottom: 5px solid var(--card-border);
    background-color: #28211b;
  }

  .product-table thead th {
    padding: 16px 20px;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-align: left;
    background: #1f1b1b;
  }

  /* Rows */
  .product-table tbody tr {
    border-bottom: 1px solid var(--card-border);
    transition: background 0.2s ease;
  }

  .product-table tbody tr:last-child {
    border-bottom: none;
  }

  .product-table tbody tr:hover {
    background: var(--row-hover);
  }

  .product-table td {
    padding: 16px 20px;
    color: var(--text-primary);
    font-size: 0.88rem;
    vertical-align: middle;
  }

  /* Product image cell */
  .product-thumb {
    width: 52px;
    height: 52px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--card-border);
    transition: transform 0.2s ease;
  }

  .product-table tbody tr:hover .product-thumb {
    transform: scale(1.08);
  }

  /* Product name */
  .product-name-cell {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  /* Category badge */
  .category-badge {
    background: var(--accent-glow);
    border: 1px solid rgba(201,168,76,0.25);
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 100px;
    white-space: nowrap;
  }

  /* Price */
  .price-cell {
    color: var(--accent);
    font-weight: 500;
    font-size: 0.95rem;
  }

  /* Description truncate */
  .desc-cell {
    color: var(--text-muted);
    font-size: 0.82rem;
    max-width: 200px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Action buttons */
  .action-btns {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .btn-edit, .btn-delete {
    border: none;
    border-radius: 8px;
    padding: 7px 14px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.15s;
    display: inline-block;
  }

  .btn-edit {
    background: var(--accent-glow);
    border: 1px solid rgba(201,168,76,0.3);
    color: var(--accent);
  }

  .btn-delete {
    background: rgba(220,60,60,0.1);
    border: 1px solid rgba(220,60,60,0.25);
    color: #e05555;
  }

  .btn-edit:hover, .btn-delete:hover {
    opacity: 0.75;
    transform: translateY(-1px);
  }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .empty-state .empty-icon { font-size: 2.5rem; margin-bottom: 12px; }

  /* Responsive scroll */
  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  @media (max-width: 576px) {
    .admin-section { padding: 30px 0; }
    .desc-cell { display: none; }
    .product-table td, .product-table th { padding: 12px 14px; }
  }
</style>

<section class="admin-section">
  <div class="container">

    <div class="admin-header">
      <h2 class="admin-title">Product <span>Management</span></h2>
      <a href="/admin/add-product" class="btn-add">+ Add Product</a>
    </div>

    <div class="table-wrap">
      <div class="table-scroll">
        <table class="product-table" id="productsTable">
          <thead>
            <tr>
              <th>Image</th>
              <th>Name</th>
              <th>Category</th>
              <th>Price</th>
              <th>Description</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each products}}
            <tr>
              <td>
                <img src="/product-images/{{this._id}}.jpg" alt="{{this.name}}" class="product-thumb">
              </td>
              <td class="product-name-cell">{{this.name}}</td>
              <td><span class="category-badge">{{this.category}}</span></td>
              <td class="price-cell">${{this.price}}</td>
              <td class="desc-cell">{{this.description}}</td>
              <td>
                <div class="action-btns">
                  <a href= "/admin/edit-product/{{this._id}}" class="btn-edit">Edit</a>
                  <a href="/admin/delete-product/{{this._id}}" class="btn-delete" onclick="return confirm('Are you sure you want to delete {{ this.name }}?')">Delete</a>
                </div>
              </td>
            </tr>
            {{/each}}

          

          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>
<script>
  $(document).ready( function () {
    $('#productsTable').DataTable();
} );
</script>