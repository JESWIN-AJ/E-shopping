<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

<style>
  :root {
    --bg: #0d0d0d;
    --card-bg: #161616;
    --card-border: #2a2a2a;
    --accent: #c9a84c;
    --accent-glow: rgba(201,168,76,0.1);
    --text-primary: #f0ece4;
    --text-muted: #7a7570;
    --input-bg: #1e1e1e;
    --radius: 16px;
  }

  .add-product-section {
    background: var(--bg);
    min-height: 100vh;
    padding: 60px 0;
    font-family: 'DM Sans', sans-serif;
  }

  .form-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    padding: 40px;
    max-width: 620px;
    margin: 0 auto;
    animation: fadeUp 0.5s ease both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .form-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin-bottom: 4px;
  }

  .form-title span {
    color: var(--accent);
  }

  .form-subtext {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 300;
    margin-bottom: 36px;
  }

  .form-divider {
    border: none;
    border-top: 1px solid var(--card-border);
    margin: 28px 0;
  }

  .field-group {
    margin-bottom: 22px;
  }

  .field-group label {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .field-group input,
  .field-group textarea {
    width: 100%;
    background: var(--input-bg);
    border: 1px solid var(--card-border);
    border-radius: 10px;
    color: var(--text-primary);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    padding: 12px 16px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    outline: none;
    box-sizing: border-box;
  }

  .field-group input:focus,
  .field-group textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .field-group input::placeholder,
  .field-group textarea::placeholder {
    color: #3a3a3a;
  }

  .field-group textarea {
    resize: vertical;
    min-height: 100px;
  }

  /* Two-column row for Name + Category */
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  /* File upload custom style */
  .file-upload-wrap {
    position: relative;
    background: var(--input-bg);
    border: 1px dashed var(--card-border);
    border-radius: 10px;
    padding: 28px 16px;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .file-upload-wrap:hover {
    border-color: var(--accent);
    background: var(--accent-glow);
  }

  .file-upload-wrap input[type="file"] {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    width: 100%;
    height: 100%;
  }

  .file-upload-icon {
    font-size: 1.8rem;
    margin-bottom: 8px;
  }

  .file-upload-text {
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .file-upload-text span {
    color: var(--accent);
    font-weight: 500;
  }

  .file-name-display {
    margin-top: 8px;
    font-size: 0.78rem;
    color: var(--accent);
    min-height: 16px;
  }

  /* Submit button */
  .btn-submit {
    width: 100%;
    background: var(--accent);
    color: #0d0d0d;
    border: none;
    border-radius: 100px;
    padding: 14px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    margin-top: 10px;
  }

  .btn-submit:hover {
    opacity: 0.88;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(201,168,76,0.3);
  }

  .btn-submit:active {
    transform: scale(0.98);
  }

  @media (max-width: 576px) {
    .form-card { padding: 24px 18px; }
    .field-row { grid-template-columns: 1fr; }
  }
</style>

<section class="add-product-section">
  <div class="container">
    <div class="form-card">

      <h2 class="form-title">Add <span>Product</span></h2>
      <p class="form-subtext">Fill in the details to list a new item</p>

      <form action="/admin/add-product" method="POST" enctype="multipart/form-data">

        <div class="field-row">
          <div class="field-group">
            <label for="name">Product Name</label>
            <input type="text" id="name" name="name" placeholder="e.g. Leather Wallet" required>
          </div>
          <div class="field-group">
            <label for="category">Category</label>
            <input type="text" id="category" name="category" placeholder="e.g. Accessories" required>
          </div>
        </div>

        <div class="field-group">
          <label for="price">Price (USD)</label>
          <input type="number" id="price" name="price" placeholder="0.00" required>
        </div>

        <div class="field-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="3" placeholder="Describe the product..." required></textarea>
        </div>

        <div class="field-group">
          <label>Product Image</label>
          <div class="file-upload-wrap">
            <input type="file" id="image" name="image" accept="image/*" required
              onchange="document.getElementById('fileName').textContent = this.files[0]?.name || ''">
            <div class="file-upload-icon">📷</div>
            <div class="file-upload-text"><span>Click to upload</span> or drag & drop</div>
            <div class="file-upload-text">PNG, JPG, WEBP supported</div>
          </div>
          <div class="file-name-display" id="fileName"></div>
        </div>

        <hr class="form-divider">

        <button type="submit" class="btn-submit">Submit Product</button>

      </form>
    </div>
  </div>
</section>