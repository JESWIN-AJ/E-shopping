<link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap"
    rel="stylesheet">

<style>
    :root {
        --bg: #0d0d0d;
        --card-bg: #161616;
        --card-border: #2a2a2a;
        --accent: #c9a84c;
        --accent-glow: rgba(201, 168, 76, 0.1);
        --accent-glow-strong: rgba(201, 168, 76, 0.18);
        --text-primary: #f0ece4;
        --text-muted: #7a7570;
        --input-bg: #1e1e1e;
        --radius: 16px;
        --danger: #e05555;
        --success: #4caf7d;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: var(--bg);
        font-family: 'DM Sans', sans-serif;
        min-height: 100vh;
        color: var(--text-primary);
    }

    .bg-glow {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
    }

    .bg-glow::before {
        content: '';
        position: absolute;
        width: 700px;
        height: 700px;
        background: radial-gradient(circle, rgba(201, 168, 76, 0.06) 0%, transparent 70%);
        top: -150px;
        left: -150px;
        border-radius: 50%;
    }

    .bg-glow::after {
        content: '';
        position: absolute;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(201, 168, 76, 0.04) 0%, transparent 70%);
        bottom: -100px;
        right: -100px;
        border-radius: 50%;
    }

    /* ── Page wrapper ── */
    .checkout-page {
        position: relative;
        z-index: 1;
        max-width: 1100px;
        margin: 0 auto;
        padding: 48px 24px 80px;
    }

    /* ── Page heading ── */
    .page-heading {
        display: flex;
        align-items: baseline;
        gap: 14px;
        margin-bottom: 36px;
        animation: fadeUp 0.45s ease both;
    }

    .page-heading h1 {
        font-family: 'Playfair Display', serif;
        font-size: 2.2rem;
        letter-spacing: -0.02em;
        color: var(--text-primary);
    }

    .page-heading h1 span {
        color: var(--accent);
    }

    .step-badge {
        font-size: 0.8rem;
        color: var(--text-muted);
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 100px;
        padding: 3px 12px;
        letter-spacing: 0.06em;
    }

    @keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(24px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Layout grid ── */
    .checkout-layout {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 28px;
        align-items: start;
        animation: fadeUp 0.5s 0.1s ease both;
    }

    @media (max-width: 820px) {
        .checkout-layout {
            grid-template-columns: 1fr;
        }

        .page-heading h1 {
            font-size: 1.7rem;
        }
    }

    /* ── Card ── */
    .checkout-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 28px;
        margin-bottom: 16px;
        transition: border-color 0.25s;
    }

    .checkout-card:last-child {
        margin-bottom: 0;
    }

    .card-section-title {
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 22px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .card-section-title::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--card-border);
    }

    /* ── Form ── */
    .form-group {
        margin-bottom: 18px;
    }

    .form-group:last-child {
        margin-bottom: 0;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    label {
        display: block;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 8px;
    }

    input[type="text"],
    input[type="tel"],
    textarea {
        width: 100%;
        background: var(--input-bg);
        border: 1px solid var(--card-border);
        border-radius: 10px;
        padding: 13px 16px;
        color: var(--text-primary);
        font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    input[type="text"]:focus,
    input[type="tel"]:focus,
    textarea:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-glow);
    }

    input::placeholder,
    textarea::placeholder {
        color: #3a3a3a;
    }

    textarea {
        resize: none;
        height: 88px;
    }

    input.error,
    textarea.error {
        border-color: var(--danger);
        box-shadow: 0 0 0 3px rgba(224, 85, 85, 0.1);
    }

    .error-msg {
        font-size: 0.72rem;
        color: var(--danger);
        margin-top: 5px;
        display: none;
    }

    .error-msg.show {
        display: block;
    }

    /* ── Payment options ── */
    .payment-options {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .payment-option {
        position: relative;
        cursor: pointer;
    }

    .payment-option input[type="radio"] {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
    }

    .payment-label {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 20px 14px;
        border: 1px solid var(--card-border);
        border-radius: 14px;
        background: var(--input-bg);
        cursor: pointer;
        transition: all 0.2s;
        text-align: center;
    }

    .payment-label:hover {
        border-color: rgba(201, 168, 76, 0.3);
        background: #1c1c1c;
    }

    .payment-option input[type="radio"]:checked+.payment-label {
        border-color: var(--accent);
        background: #1c1a0f;
        box-shadow: 0 0 0 3px var(--accent-glow);
    }

    .payment-icon {
        font-size: 24px;
    }

    .payment-name {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text-primary);
    }

    .payment-desc {
        font-size: 0.72rem;
        color: var(--text-muted);
    }

    .check-dot {
        width: 18px;
        height: 18px;
        border: 1.5px solid var(--card-border);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 4px;
        transition: all 0.2s;
        font-size: 10px;
        color: transparent;
    }

    .payment-option input[type="radio"]:checked+.payment-label .check-dot {
        border-color: var(--accent);
        background: var(--accent);
        color: #000;
    }

    /* ── Summary card (right column) ── */
    .summary-card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 24px;
        padding: 28px 28px 32px;
        position: sticky;
        top: 24px;
    }

    .summary-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.15rem;
        color: var(--text-primary);
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--card-border);
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.83rem;
        color: var(--text-muted);
        margin-bottom: 12px;
    }

    .summary-row .val {
        color: var(--text-primary);
        font-weight: 400;
    }

    .summary-divider {
        border: none;
        border-top: 1px solid var(--card-border);
        margin: 18px 0;
    }

    .summary-total {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 28px;
    }

    .summary-total .label {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-muted);
        font-weight: 500;
    }

    .summary-total .amount {
        font-family: 'Playfair Display', serif;
        font-size: 1.6rem;
        color: var(--accent);
    }

    /* Order items mini list */
    .order-items {
        margin-bottom: 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .order-item-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.82rem;
    }

    .order-item-name {
        color: var(--text-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 160px;
    }

    .order-item-name span {
        color: var(--text-primary);
        font-weight: 500;
    }

    .order-item-price {
        color: var(--accent);
        font-weight: 500;
    }

    /* Place order button */
    .btn-place-order {
        display: block;
        width: 100%;
        background: var(--accent);
        color: #0d0d0d;
        border: none;
        border-radius: 100px;
        padding: 14px;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;
        text-align: center;
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
    }

    .btn-place-order:hover {
        opacity: 0.88;
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(201, 168, 76, 0.3);
    }

    .btn-place-order:active {
        transform: scale(0.98);
    }

    .btn-back {
        display: block;
        width: 100%;
        background: transparent;
        color: var(--text-muted);
        border: 1px solid var(--card-border);
        border-radius: 100px;
        padding: 13px;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.83rem;
        text-align: center;
        text-decoration: none;
        margin-top: 12px;
        transition: border-color 0.2s, color 0.2s;
        cursor: pointer;
    }

    .btn-back:hover {
        border-color: var(--accent);
        color: var(--text-primary);
    }

    /* Trust badges */
    .trust-badges {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid var(--card-border);
    }

    .badge {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        font-size: 0.68rem;
        color: var(--text-muted);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        text-align: center;
    }

    .badge-icon {
        font-size: 1.1rem;
        opacity: 0.5;
    }

    /* Success overlay */
    .success-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.85);
        z-index: 100;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 16px;
        text-align: center;
        padding: 20px;
    }

    .success-overlay.show {
        display: flex;
        animation: fadeUp 0.4s ease;
    }

    .success-icon {
        width: 72px;
        height: 72px;
        background: var(--success);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
    }

    .success-overlay h2 {
        font-family: 'Playfair Display', serif;
        font-size: 1.8rem;
        color: var(--text-primary);
    }

    .success-overlay p {
        color: var(--text-muted);
        font-size: 0.88rem;
        max-width: 300px;
    }
</style>

<div class="bg-glow"></div>

<div class="checkout-page">
    <form action="" id="checkout-form">


        <div class="page-heading">
            <h1>Check<span>out</span></h1>
            <span class="step-badge">Final Step</span>
        </div>

        <div class="checkout-layout">

            <!-- ── Left: Form ── -->
            <div>

                <!-- Delivery Details -->
                <div class="checkout-card">
                    <div class="card-section-title">Delivery Details</div>

                    <div class="form-group">
                        <label>Full Address</label>
                        <textarea id="address" name="address" placeholder="House no, Street, Area, City..."></textarea>
                        <div class="error-msg" id="address-err">Please enter your address</div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Pincode</label>
                            <input type="text" id="pincode" name="pincode" placeholder="e.g. 673001" maxlength="6" />
                            <div class="error-msg" id="pincode-err">Enter valid 6-digit pincode</div>
                        </div>
                        <div class="form-group">
                            <label>Mobile Number</label>
                            <input type="tel" id="mobile" name="mobile" placeholder="e.g. 9876543210" maxlength="10" />
                            <div class="error-msg" id="mobile-err">Enter valid 10-digit number</div>
                        </div>
                        <input type="text" name="userId" id="" value="{{user._id}}" hidden>

                    </div>
                </div>

                <!-- Payment Method -->
                <div class="checkout-card">
                    <div class="card-section-title">Payment Method</div>

                    <div class="payment-options">
                        <label class="payment-option">
                            <input type="radio" name="payment" value="cod" checked />
                            <div class="payment-label">
                                <div class="payment-icon">💵</div>
                                <div class="payment-name">Cash on Delivery</div>
                                <div class="payment-desc">Pay when delivered</div>
                                <div class="check-dot">✓</div>
                            </div>
                        </label>

                        <label class="payment-option">
                            <input type="radio" name="payment" value="online" />
                            <div class="payment-label">
                                <div class="payment-icon">💳</div>
                                <div class="payment-name">Online Payment</div>
                                <div class="payment-desc">UPI · Card · Net Banking</div>
                                <div class="check-dot">✓</div>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <!-- ── Right: Order Summary ── -->
            <div class="summary-card">
                <p class="summary-title">Order Summary</p>

                <!-- Mini item list -->
                <div class="order-items">
                    {{#each products}}
                    <div class="order-item-row">
                        <span class="order-item-name"><span>{{this.product.name}}</span> × {{this.quantity}}</span>
                        <span class="order-item-price">₹{{this.total}}</span>
                    </div>
                    {{/each}}
                </div>

                <div class="summary-row">
                    <span>Subtotal</span>
                    <span class="val">₹{{grandTotal}}</span>
                </div>
                <div class="summary-row">
                    <span>Delivery</span>
                    <span class="val">₹49</span>
                </div>
                <div class="summary-row">
                    <span>tax</span>
                    <span class="val">4%</span>
                </div>

                <hr class="summary-divider">

                <div class="summary-total">
                    <span class="label">Total</span>
                    <span class="amount">₹{{grandTotal}}</span>
                </div>

                <button class="btn-place-order" id="placeOrderBtn" type="submit">Place Order →</button>
                <a href="/cart" class="btn-back">← Back to Cart</a>

                <div class="trust-badges">
                    <div class="badge"><span class="badge-icon">🔒</span>Secure</div>
                    <div class="badge"><span class="badge-icon">↩</span>Easy Returns</div>
                    <div class="badge"><span class="badge-icon">🚚</span>Fast Ship</div>
                </div>
            </div>

        </div>
    </form>
</div>

<!-- Success Popup -->
<div class="success-overlay" id="successOverlay">
    <div class="success-icon">✓</div>
    <h2>Order Placed!</h2>
    <p>Your order has been confirmed. You'll receive an update shortly.</p>
</div>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
  $('#checkout-form').submit((e) => {
    e.preventDefault();

    $.ajax({
      url: '/checkout',
      method: 'post',
      data: $('#checkout-form').serialize(),  // ✅ serialize works since all inputs have name
      success: (response) => {
        console.log('Checkout response:', response)
        if (response.codSuccess) {
          location.href = '/order-success'  // ✅ redirect on COD success;
        } else {
          razorpayPayment(response)  // ✅ open razorpay
        }
      },
      error: () => {
        alert('Something went wrong. Please try again.');
      }
    });
  });

  function razorpayPayment(order) {
    var options = {
      "key": "rzp_test_SYiWQsxdtf6RlX",
      "amount": order.amount,  // amount in paise
      "currency": "INR",
      "name": "funnel.io",
      "description": "Test Transaction",
      "order_id": order.id,
      "handler": function (response) {
        verifyPayment(response, order)  // ✅ removed alerts
      },
      "prefill": {
        "name": "{{user.name}}",
        "contact": document.getElementById('mobile').value
      },
      "theme": { "color": "#c9a84c" }
    };

    var rzp1 = new Razorpay(options);
    rzp1.on('payment.failed', function (response) {
      alert('Payment failed: ' + response.error.description);
    });
    rzp1.open();  // ✅ removed rzp-button1 — open directly
  }

  function verifyPayment(payment, order) {
    $.ajax({
      url: '/verify-payment',
      method: 'post',
      data: {
        // ✅ flat fields not nested object
        order,
        razorpay_payment_id: payment.razorpay_payment_id,
        razorpay_order_id:   payment.razorpay_order_id,
        razorpay_signature:  payment.razorpay_signature,
        orderId:             order.receipt
      },
      success: (response) => {
        console.log('Verify response:', response)
        if (response.status) {
          location.href = '/order-success'
        } else {
          alert('Payment verification failed')
        }
      },
      error: () => {
        alert('Verification error')
      }
    });
  }
</script>