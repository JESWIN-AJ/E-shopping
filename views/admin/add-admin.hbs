<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

<style>
  :root {
    --bg: #0d0d0d;
    --card-bg: #161616;
    --card-border: #2a2a2a;
    --accent: #c9a84c;
    --accent-glow: rgba(201,168,76,0.1);
    --text-primary: #f0ece4;
    --text-muted: #7a7570;
    --input-bg: #1e1e1e;
    --radius: 16px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    font-family: 'DM Sans', sans-serif;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bg-glow {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .bg-glow::before {
    content: '';
    position: absolute;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(201,168,76,0.07) 0%, transparent 70%);
    top: -100px;
    right: -100px;
    border-radius: 50%;
  }

  .bg-glow::after {
    content: '';
    position: absolute;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(201,168,76,0.05) 0%, transparent 70%);
    bottom: -80px;
    left: -80px;
    border-radius: 50%;
  }

  .signup-page {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
  }

  .signup-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 24px;
    padding: 48px 44px;
    width: 100%;
    max-width: 440px;
    animation: fadeUp 0.5s ease both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .signup-brand {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    color: var(--text-primary);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 32px;
  }

  .signup-brand span { color: var(--accent); }

  .signup-title {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin-bottom: 6px;
  }

  .signup-title span { color: var(--accent); }

  .signup-subtitle {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 300;
    margin-bottom: 36px;
  }

  /* Two column row */
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .field-group {
    margin-bottom: 18px;
  }

  .field-group label {
    display: block;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .field-group input {
    width: 100%;
    background: var(--input-bg);
    border: 1px solid var(--card-border);
    border-radius: 10px;
    color: var(--text-primary);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    padding: 13px 16px;
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
  }

  .field-group input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .field-group input::placeholder { color: #3a3a3a; }

  /* Password wrap */
  .password-wrap {
    position: relative;
  }

  .password-wrap input {
    width: 100%;
    background: var(--input-bg);
    border: 1px solid var(--card-border);
    border-radius: 10px;
    color: var(--text-primary);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    padding: 13px 44px 13px 16px;
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
  }

  .password-wrap input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .password-wrap input::placeholder { color: #3a3a3a; }

  .toggle-password {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-muted);
    font-size: 1rem;
    padding: 0;
    transition: color 0.2s;
  }

  .toggle-password:hover { color: var(--accent); }

  /* Terms */
  .terms-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 6px 0 26px;
  }

  .terms-row input[type="checkbox"] {
    appearance: none;
    width: 17px;
    height: 17px;
    min-width: 17px;
    border: 1px solid var(--card-border);
    border-radius: 5px;
    background: var(--input-bg);
    cursor: pointer;
    position: relative;
    margin-top: 2px;
    transition: border-color 0.2s, background 0.2s;
  }

  .terms-row input[type="checkbox"]:checked {
    background: var(--accent);
    border-color: var(--accent);
  }

  .terms-row input[type="checkbox"]:checked::after {
    content: '✓';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #0d0d0d;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .terms-row label {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
    cursor: pointer;
  }

  .terms-row label a {
    color: var(--accent);
    text-decoration: none;
  }

  .terms-row label a:hover { opacity: 0.7; }

  /* Submit */
  .btn-submit {
    width: 100%;
    background: var(--accent);
    color: #0d0d0d;
    border: none;
    border-radius: 100px;
    padding: 14px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
  }

  .btn-submit:hover {
    opacity: 0.88;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(201,168,76,0.3);
  }

  .btn-submit:active { transform: scale(0.98); }

  /* Divider */
  .or-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 24px 0;
  }

  .or-divider::before,
  .or-divider::after {
    content: '';
    flex: 1;
    border-top: 1px solid var(--card-border);
  }

  .or-divider span {
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Google */
  .btn-google {
    width: 100%;
    background: transparent;
    border: 1px solid var(--card-border);
    border-radius: 100px;
    padding: 13px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
    text-decoration: none;
  }

  .btn-google:hover {
    border-color: var(--accent);
    color: var(--text-primary);
    background: var(--accent-glow);
  }

  /* Login prompt */
  .login-prompt {
    text-align: center;
    margin-top: 28px;
    font-size: 0.83rem;
    color: var(--text-muted);
  }

  .login-prompt a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.2s;
  }

  .login-prompt a:hover { opacity: 0.7; }

  @media (max-width: 480px) {
    .signup-card { padding: 32px 22px; }
    .signup-title { font-size: 1.7rem; }
    .field-row { grid-template-columns: 1fr; gap: 0; }
  }
</style>

<div class="bg-glow"></div>

<div class="signup-page">
  <div class="signup-card">

    <a href="/" class="signup-brand">E<span>.</span>Shop</a>

    <h1 class="signup-title">Create <span>Account</span></h1>
    <p class="signup-subtitle">Join us — it only takes a minute</p>

    <form action="/admin/add-admin" method="POST">

      <!-- Name row -->
      <div class="field-row">
        <div class="field-group">
          <label for="firstname">First Name</label>
          <input type="text" id="firstname" name="firstname" placeholder="John" required>
        </div>
        <div class="field-group">
          <label for="lastname">Last Name</label>
          <input type="text" id="lastname" name="lastname" placeholder="Doe" required>
        </div>
      </div>

      <!-- Email -->
      <div class="field-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" placeholder="you@example.com" required>
      </div>

      <!-- Phone -->
    
      <!-- Password -->
      <div class="field-group">
        <label for="password">Password</label>
        <div class="password-wrap">
          <input type="password" id="password" name="password" placeholder="Min. 8 characters" required>
          <button type="button" class="toggle-password" onclick="togglePass()">👁</button>
        </div>
      </div>

      

      <button type="submit" class="btn-submit">Create Account</button>

    </form>

    <div class="or-divider"><span>or</span></div>

   

    <p class="login-prompt">
      Already have an account? <a href="/login">Sign in</a>
    </p>

  </div>
</div>

<script>
  function togglePass() {
    const input = document.getElementById('password');
    const btn = event.currentTarget;
    if (input.type === 'password') {
      input.type = 'text';
      btn.textContent = '🙈';
    } else {
      input.type = 'password';
      btn.textContent = '👁';
    }
  }
</script>