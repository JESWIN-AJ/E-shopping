<link
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap"
  rel="stylesheet">

<style>
  :root {
    --bg: #0d0d0d;
    --card-bg: #161616;
    --card-border: #2a2a2a;
    --accent: #c9a84c;
    --accent-glow: rgba(201, 168, 76, 0.15);
    --text-primary: #f0ece4;
    --text-muted: #7a7570;
    --radius: 16px;
  }

  .shop-section {
    background: var(--bg);
    min-height: 100vh;
    padding: 60px 0;
    font-family: 'DM Sans', sans-serif;
  }

  .shop-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 4vw, 3rem);
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin-bottom: 4px;
  }

  .shop-heading span {
    color: var(--accent);
  }

  .shop-subtext {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 300;
    margin-bottom: 48px;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 24px;
    padding: 0 8px;
  }

  .product-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    position: relative;
  }

  .product-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    background: var(--accent-glow);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 0;
  }

  .product-card:hover {
    transform: translateY(-6px);
    border-color: var(--accent);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 0 1px var(--accent);
  }

  .product-card:hover::before {
    opacity: 1;
  }

  .product-image-wrap {
    position: relative;
    overflow: hidden;
    background: #1e1e1e;
    aspect-ratio: 4/3;
  }

  .product-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .product-card:hover .product-image-wrap img {
    transform: scale(1.07);
  }

  .product-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--accent);
    color: #0d0d0d;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 100px;
    z-index: 1;
  }

  .product-body {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: relative;
    z-index: 1;
  }

  .product-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.05rem;
    color: var(--text-primary);
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  .product-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--card-border);
  }

  .product-price {
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: -0.01em;
  }

  .btn-cart {
    background: transparent;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 8px 16px;
    border-radius: 100px;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease;
    font-family: 'DM Sans', sans-serif;
  }

  .btn-cart:hover {
    background: var(--accent);
    color: #0d0d0d;
    transform: scale(1.04);
  }

  .btn-cart:active {
    transform: scale(0.97);
  }

  /* Staggered fade-in animation */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .product-card {
    animation: fadeUp 0.5s ease both;
  }

  .product-card:nth-child(1) {
    animation-delay: 0.05s;
  }

  .product-card:nth-child(2) {
    animation-delay: 0.1s;
  }

  .product-card:nth-child(3) {
    animation-delay: 0.15s;
  }

  .product-card:nth-child(4) {
    animation-delay: 0.2s;
  }

  .product-card:nth-child(5) {
    animation-delay: 0.25s;
  }

  .product-card:nth-child(6) {
    animation-delay: 0.3s;
  }

  .product-card:nth-child(7) {
    animation-delay: 0.35s;
  }

  .product-card:nth-child(8) {
    animation-delay: 0.4s;
  }

  /* Responsive tweaks */
  @media (max-width: 576px) {
    .products-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 14px;
    }

    .product-body {
      padding: 14px;
    }

    .product-name {
      font-size: 0.95rem;
    }
  }
</style>

<section class="shop-section">
  <div class="container">
    <h2 class="shop-heading">Our <span>Collection</span></h2>
    <p class="shop-subtext">Curated picks, just for you</p>

    <div class="products-grid">
      {{#each products}}
      <div class="product-card">
        <div class="product-image-wrap">
          <img src="/product-images/{{this._id}}.jpg" alt="{{this.name}}">
          <span class="product-badge">New</span>
        </div>
        <div class="product-body">
          <h5 class="product-name">{{this.name}}</h5>
          <p class="product-desc">{{this.description}}</p>
          <div class="product-footer">
            <span class="product-price">${{this.price}}</span>
            {{!-- <a class="btn-cart" href="/add-to-cart/{{this._id}}">Add to Cart</a> --}}
            <button class="btn-cart" onclick="addToCart('{{this._id}}')">

              Add to cart
            </button>
          </div>
        </div>
      </div>
      {{/each}}
    </div>

  </div>
</section>

