<link
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap"
  rel="stylesheet">

<style>
  :root {
    --bg: #0d0d0d;
    --card-bg: #161616;
    --card-border: #2a2a2a;
    --accent: #c9a84c;
    --accent-glow: rgba(201, 168, 76, 0.1);
    --text-primary: #f0ece4;
    --text-muted: #7a7570;
    --radius: 16px;
  }

  .luxury-nav {
    background: rgba(13, 13, 13, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--card-border);
    padding: 0 24px;
    position: sticky;
    top: 0;
    z-index: 1000;
    font-family: 'DM Sans', sans-serif;
  }

  .nav-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 24px;
  }

  /* Brand */
  .nav-brand {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.01em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-brand span {
    color: var(--accent);
  }

  /* Center links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 400;
    padding: 8px 14px;
    border-radius: 8px;
    transition: color 0.2s, background 0.2s;
    white-space: nowrap;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--text-primary);
    background: var(--card-bg);
  }

  /* Shared dropdown styles */
  .nav-dropdown,
  .auth-dropdown {
    position: relative;
        color: var(--text-muted);

  }

  .nav-dropdown>a {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .nav-dropdown>a::after {
    content: '';
    width: 6px;
    height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.2s;
  }

  .nav-dropdown:hover>a::after {
    transform: rotate(225deg) translateY(-2px);
  }

  .dropdown-menu-custom,
  .auth-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 8px;
    min-width: 160px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
    z-index: 100;
  }

  .auth-menu {
    left: auto;
    right: 0;
    min-width: 140px;
  }

  .nav-dropdown:hover .dropdown-menu-custom,
  .auth-dropdown:hover .auth-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-menu-custom a,
  .auth-menu a {
    display: block;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.83rem;
    padding: 9px 14px;
    border-radius: 8px;
    transition: color 0.2s, background 0.2s;
  }

  .dropdown-menu-custom a:hover,
  .auth-menu a:hover {
    color: var(--text-primary);
    background: #912020;
  }

  .dropdown-divider {
    border: none;
    border-top: 1px solid var(--card-border);
    margin: 6px 0;
  }

  /* Cart */
  .cart-link {
    position: relative;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    padding: 8px 14px;
    border-radius: 8px;
    transition: color 0.2s, background 0.2s;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cart-link:hover {
    color: var(--text-primary);
    background: var(--card-bg);
  }

  .cart-badge {
    background: var(--accent);
    color: #0d0d0d;
    font-size: 0.6rem;
    font-weight: 700;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 2px;
    right: 4px;
  }

  /* Right side */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  /* Search */
  .search-wrap {
    display: flex;
    align-items: center;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 100px;
    padding: 6px 14px;
    gap: 8px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .search-wrap:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .search-wrap input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    width: 140px;
  }

  .search-wrap input::placeholder {
    color: var(--text-muted);
  }

  .search-icon {
    color: var(--text-muted);
    font-size: 0.9rem;
    cursor: pointer;
    transition: color 0.2s;
  }

  .search-icon:hover {
    color: var(--accent);
  }

  /* Account button */
  .btn-signup {
    background: var(--accent);
    color: #0d0d0d;
    border: none;
    border-radius: 100px;
    padding: 8px 18px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
    white-space: nowrap;
    display: inline-block;
  }

  .btn-signup:hover {
    opacity: 0.85;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(201, 168, 76, 0.3);
    color: #0d0d0d;
  }

  /* Mobile login/signup buttons */
  .btn-login {
    background: transparent;
    border: 1px solid var(--card-border);
    color: var(--text-muted);
    border-radius: 100px;
    padding: 8px 18px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
    white-space: nowrap;
    display: inline-block;
    text-align: center;
  }

  .btn-login:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 6px;
    background: none;
    border: none;
  }

  .hamburger span {
    width: 22px;
    height: 2px;
    background: var(--text-muted);
    border-radius: 2px;
    transition: all 0.3s ease;
    display: block;
  }

  /* Mobile menu */
  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 16px 0 20px;
    border-top: 1px solid var(--card-border);
    animation: fadeUp 0.2s ease;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-menu.open {
    display: flex;
  }

  .mobile-menu a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    padding: 10px 14px;
    border-radius: 10px;
    transition: color 0.2s, background 0.2s;
  }

  .mobile-menu a:hover {
    color: var(--text-primary);
    background: var(--card-bg);
  }

  .mobile-divider {
    border: none;
    border-top: 1px solid var(--card-border);
    margin: 8px 0;
  }

  .mobile-auth {
    display: flex;
    gap: 10px;
    padding: 4px 14px 0;
  }

  .mobile-auth a {
    flex: 1;
    text-align: center;
  }

  @media (max-width: 768px) {

    .nav-links,
    .search-wrap,
    .nav-right {
      display: none;
    }

    .hamburger {
      display: flex;
    }

    .nav-inner {
      height: 58px;
    }
  }
</style>

<header>
  <nav class="luxury-nav">
    <div class="nav-inner">

      <!-- Brand -->
      <a href="/" class="nav-brand">E<span>.</span>Shop</a>

      <!-- Center Nav Links -->
      <ul class="nav-links">
        <li><a href="/" class="active">Home</a></li>
        <li>
          <a href="/cart" class="cart-link">
            Cart
            <span class="cart-badge" id="cart-count">{{cartCount}}</span>
          </a>
        </li>
        <li class="nav-dropdown">
          <a>
           PRODUCTS

          </a>
        {{#if user}}  
          <div class="dropdown-menu-custom">
            <a href="/products">Products</a>
            <a href="/order-success"> Orders</a>
            <div class="dropdown-divider"></div>
            <a href="/wishlist">❤️ Wishlist</a>
          </div>
        </li>
        
        {{else}}
        <div class="dropdown-menu-custom">
            <a href="/products">Products</a>
          
          </div>
        {{/if}}

      </ul>

      <!-- Right: Search + Single Account Button -->
      <div class="nav-right">
        <div class="search-wrap">
          <span class="search-icon">🔍</span>
          <input type="text" placeholder="Search products...">
        </div>

        <!-- Single dropdown button for login/signup -->
        <div class="auth-dropdown">
          <button class="btn-signup">
            <a>
              {{#if user}}
              {{user.firstname}}
              {{else}}
              Account
              {{/if}}

            </a>
          </button>
          <div class="auth-menu">
            {{#if user}}
            <a href="/profile">👤 Profile</a>
            <a href="/orders">📦 Orders</a>
            <a href="/logout">🚪 Logout</a>
            {{else}}
            <a href="/login"> Log in</a>
            <a href="/signup"> Sign up</a>
            {{/if }}
          </div>
        </div>
      </div>

      <!-- Hamburger (mobile) -->
      <button class="hamburger" onclick="toggleMenu()" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>

    </div>

    <!-- Mobile Menu -->
    {{!-- <div class="mobile-menu" id="mobileMenu">
      <a href="/">Home</a>
      <a href="/products">Products</a>
      <a href="/profile">👤 Profile</a>
      <a href="/orders">📦 Orders</a>
      <a href="/cart">🛒 Cart</a>
      <hr class="mobile-divider">
      <div class="mobile-auth">
        <a href="/login" class="btn-login">Log in</a>
        <a href="/signup" class="btn-signup">Sign up</a>
      </div>
    </div> --}}

  </nav>
</header>

<script>
  function toggleMenu() {
    const menu = document.getElementById('mobileMenu');
    menu.classList.toggle('open');
  }
</script>