<link
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap"
  rel="stylesheet">

<style>
  :root {
    --bg: #0d0d0d;
    --card-bg: #161616;
    --card-border: #2a2a2a;
    --accent: #c9a84c;
    --accent-glow: rgba(201, 168, 76, 0.1);
    --accent-glow-strong: rgba(201, 168, 76, 0.18);
    --text-primary: #f0ece4;
    --text-muted: #7a7570;
    --input-bg: #1e1e1e;
    --radius: 16px;
    --danger: #e05555;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    background: var(--bg);
    font-family: 'DM Sans', sans-serif;
    min-height: 100vh;
    color: var(--text-primary);
  }

  .bg-glow {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .bg-glow::before {
    content: '';
    position: absolute;
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.06) 0%, transparent 70%);
    top: -150px;
    left: -150px;
    border-radius: 50%;
  }

  .bg-glow::after {
    content: '';
    position: absolute;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.04) 0%, transparent 70%);
    bottom: -100px;
    right: -100px;
    border-radius: 50%;
  }

  /* ── Navbar ── */
  .navbar {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 48px;
    border-bottom: 1px solid var(--card-border);
    background: rgba(13, 13, 13, 0.85);
    backdrop-filter: blur(10px);
  }

  .brand {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    color: var(--text-primary);
    text-decoration: none;
  }

  .brand span {
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    gap: 28px;
    list-style: none;
  }

  .nav-links a {
    font-size: 0.82rem;
    color: var(--text-muted);
    text-decoration: none;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--accent);
  }

  /* ── Page wrapper ── */
  .cart-page {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 48px 24px 80px;
  }

  /* ── Page heading ── */
  .page-heading {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 36px;
    animation: fadeUp 0.45s ease both;
  }

  .page-heading h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2.2rem;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .page-heading h1 span {
    color: var(--accent);
  }

  .item-count {
    font-size: 0.8rem;
    color: var(--text-muted);
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 100px;
    padding: 3px 12px;
    letter-spacing: 0.06em;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Layout grid ── */
  .cart-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 28px;
    align-items: start;
    animation: fadeUp 0.5s 0.1s ease both;
  }

  @media (max-width: 820px) {
    .cart-layout {
      grid-template-columns: 1fr;
    }

    .navbar {
      padding: 16px 20px;
    }

    .page-heading h1 {
      font-size: 1.7rem;
    }
  }

  /* ── Cart items column ── */
  .cart-items {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* ── Single cart item card ── */
  .cart-item {
    display: flex;
    align-items: center;
    gap: 20px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 20px;
    padding: 20px 24px;
    transition: border-color 0.25s, box-shadow 0.25s;
  }

  .cart-item:hover {
    border-color: rgba(201, 168, 76, 0.25);
    box-shadow: 0 0 28px rgba(201, 168, 76, 0.05);
  }

  /* Product image */
  .item-thumb {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    object-fit: cover;
    background: var(--input-bg);
    flex-shrink: 0;
    border: 1px solid var(--card-border);
  }

  /* Text info */
  .item-info {
    flex: 1;
    min-width: 0;
  }

  .item-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.05rem;
    color: var(--text-primary);
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .item-variant {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 300;
  }

  .item-unit-price {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 6px;
  }

  .item-unit-price span {
    color: var(--accent);
    font-weight: 500;
  }

  /* Qty controls */
  .qty-ctrl {
    display: flex;
    align-items: center;
    gap: 0;
    background: var(--input-bg);
    border: 1px solid var(--card-border);
    border-radius: 100px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .qty-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    width: 36px;
    height: 36px;
    font-size: 1.1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s, background 0.2s;
    text-decoration: none;
    line-height: 1;
  }

  .qty-btn:hover {
    color: var(--accent);
    background: var(--accent-glow);
  }

  .qty-val {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-primary);
    min-width: 28px;
    text-align: center;
    pointer-events: none;
  }

  /* Line total */
  .item-total {
    font-size: 1rem;
    font-weight: 500;
    color: var(--accent);
    min-width: 80px;
    text-align: right;
    flex-shrink: 0;
    font-family: 'Playfair Display', serif;
  }

  /* Remove */
  .remove-btn {
    background: none;
    border: 1px solid transparent;
    border-radius: 8px;
    color: var(--text-muted);
    font-size: 0.9rem;
    cursor: pointer;
    padding: 6px 8px;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .remove-btn:hover {
    color: var(--danger);
    border-color: rgba(224, 85, 85, 0.3);
    background: rgba(224, 85, 85, 0.07);
  }

  /* ── Empty state ── */
  .empty-state {
    text-align: center;
    padding: 72px 24px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 24px;
  }

  .empty-icon {
    font-size: 3rem;
    margin-bottom: 16px;
    display: block;
    opacity: 0.4;
  }

  .empty-state h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .empty-state p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 28px;
  }

  /* ── Order summary card ── */
  .summary-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 24px;
    padding: 28px 28px 32px;
    position: sticky;
    top: 24px;
  }

  .summary-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.15rem;
    color: var(--text-primary);
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--card-border);
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.83rem;
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  .summary-row .val {
    color: var(--text-primary);
    font-weight: 400;
  }

  .summary-row.discount .val {
    color: #5cba82;
  }

  .summary-divider {
    border: none;
    border-top: 1px solid var(--card-border);
    margin: 18px 0;
  }

  .summary-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 28px;
  }

  .summary-total .label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    font-weight: 500;
  }

  .summary-total .amount {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    color: var(--accent);
  }

  /* Coupon input */
  .coupon-row {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
  }

  .coupon-row input {
    flex: 1;
    background: var(--input-bg);
    border: 1px solid var(--card-border);
    border-radius: 10px;
    color: var(--text-primary);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    padding: 10px 14px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .coupon-row input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .coupon-row input::placeholder {
    color: #3a3a3a;
  }

  .btn-apply {
    background: var(--input-bg);
    border: 1px solid var(--card-border);
    border-radius: 10px;
    color: var(--text-muted);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 10px 16px;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
    white-space: nowrap;
  }

  .btn-apply:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Checkout button */
  .btn-checkout {
    display: block;
    width: 100%;
    background: var(--accent);
    color: #0d0d0d;
    border: none;
    border-radius: 100px;
    padding: 14px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
  }

  .btn-checkout:hover {
    opacity: 0.88;
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(201, 168, 76, 0.3);
  }

  .btn-checkout:active {
    transform: scale(0.98);
  }

  .btn-continue {
    display: block;
    width: 100%;
    background: transparent;
    color: var(--text-muted);
    border: 1px solid var(--card-border);
    border-radius: 100px;
    padding: 13px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.83rem;
    font-weight: 400;
    text-align: center;
    text-decoration: none;
    margin-top: 12px;
    transition: border-color 0.2s, color 0.2s;
    cursor: pointer;
  }

  .btn-continue:hover {
    border-color: var(--accent);
    color: var(--text-primary);
  }

  /* Trust badges */
  .trust-badges {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--card-border);
  }

  .badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-size: 0.68rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
  }

  .badge-icon {
    font-size: 1.1rem;
    opacity: 0.5;
  }

  .qty-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
</style>

<div class="bg-glow"></div>



<!-- Cart page -->
<div class="cart-page">

  <div class="page-heading">
    <h1>Your <span>Cart</span></h1>
    <span class="item-count">{{totalItems}} items</span>
  </div>

  {{#if products.length}}
  {{#each products}}

  <div class="cart-layout">

    <!-- ── Left: items ── -->
    <div class="cart-items">

      <div class="cart-item">

        <img class="item-thumb" src="/product-images/{{this.product._id}}.jpg" alt="{{this.name}}">

        <div class="item-info">
          <p class="item-name">{{this.product.name}}</p>
          <p class="item-variant">{{this.product.category}}</p>
          <p class="item-unit-price">₹{{this.product.price}} <span>/ unit</span></p>
        </div>


        <!-- Quantity -->
        <div class="qty-ctrl">
          <button class="qty-btn" id="dec" onclick="decreaseProduct('{{this._id}}','{{this.product._id}}',-1)">-</button>
          <span class="qty-val">{{this.quantity}}</span>
          <button class="qty-btn" id="inc" onclick="increaseProduct('{{this._id}}','{{this.product._id}}',1)">+</button>
        </div>

        <!-- Line total -->
        <div class="item-total">₹{{this.total}}</div>


        <!-- Remove -->
<button class="remove-btn" onclick="removeProduct('{{this._id}}','{{this.product._id}}')">Remove</button>          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            {{!-- <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button> --}}

      </div>
    </div>
    {{/each}}


    <!-- ── Right: summary ── -->
    <div class="summary-card">
      <p class="summary-title">Order Summary</p>

      <div class="summary-row">
        <span>Subtotal</span>
        <span class="val">₹{{grandTotal}}</span>
      </div>
      <div class="summary-row">
        <span>Delivery</span>
        <span class="val">₹49</span>
      </div>
      <div class="summary-row discount">
        <span>Discount</span>
        <span class="val">— ₹0</span>
      </div>

      <hr class="summary-divider">

      <div class="summary-total">
        <span class="label">Total</span>
        <span class="amount">₹{{grandTotal}}</span>
      </div>

      <!-- Coupon -->
      <div class="coupon-row">
        <input type="text" placeholder="Coupon code">
        <button class="btn-apply">Apply</button>
      </div>

      <a href="/checkout" class="btn-checkout">Proceed to Checkout</a>
      <a href="/" class="btn-continue">Continue Shopping</a>

      <!-- Trust badges -->
      <div class="trust-badges">
        <div class="badge">
          <span class="badge-icon">🔒</span>
          Secure
        </div>
        <div class="badge">
          <span class="badge-icon">↩</span>
          Easy Returns
        </div>
        <div class="badge">
          <span class="badge-icon">🚚</span>
          Fast Ship
        </div>
      </div>
    </div>

  </div>

  {{else}}

  <!-- Empty state -->
  <div class="empty-state">
    <span class="empty-icon">🛒</span>
    <h3>Your cart is empty</h3>
    <p>Looks like you haven't added anything yet.</p>
    <a href="/" class="btn-checkout" style="display:inline-block;width:auto;padding:13px 36px;">
      Browse Products
    </a>
  </div>

  {{/if}}

</div>
<script>
$(document).ready(() => {
  $('.qty-val').each(function () {
    const qty = parseInt($(this).text());
    const proId = $(this).siblings('button').last().attr('onclick').match(/'([^']+)'/g)[1].replace(/'/g, '');

    if (qty <= 1) {
      $(`#dec-${proId}`).prop('disabled', true);  // ✅ disable dec if qty is 1
    } else {
      $(`#dec-${proId}`).prop('disabled', false); // ✅ enable dec if qty > 1
    }
  });
});
</script>